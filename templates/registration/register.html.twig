{% extends 'base.html.twig' %}

{% block title %}Créer un compte — Vite & Gourmand{% endblock %}

{% block body %}
    <main class="container registration-page">
        <section class="menu-card registration-card" aria-labelledby="registration-title">
            <h1 id="registration-title">Créer un compte</h1>
            {% if registrationForm.vars.submitted and not registrationForm.vars.valid %}
                <p class="form-error" role="alert">
                    Votre compte n’a pas été créé.
                    Corrigez les erreurs indiquées ci-dessous, puis réessayez.
                </p>
            {% endif %}

            {{ form_start(registrationForm, {
                attr: registrationForm.vars.attr|merge({class: (registrationForm.vars.attr.class|default('') ~ ' registration-form registration-grouped')|trim})
            }) }}
            {{ form_errors(registrationForm) }}

            <fieldset class="registration-group">
                <legend>Identité</legend>
                <div class="registration-grid">
                    {{ form_row(registrationForm.nom) }}
                    {{ form_row(registrationForm.prenom) }}
                </div>
            </fieldset>

            <fieldset class="registration-group">
                <legend>Coordonnées</legend>
                <div class="registration-grid">
                    {{ form_row(registrationForm.email) }}
                    {{ form_row(registrationForm.telephone) }}
                </div>
            </fieldset>

            <fieldset class="registration-group">
                <legend>Adresse</legend>
                <div class="registration-grid">
                    <div class="registration-wide">{{ form_row(registrationForm.adresse) }}</div>
                    {{ form_row(registrationForm.codePostal) }}
                    {{ form_row(registrationForm.ville) }}
                </div>
            </fieldset>

            <fieldset class="registration-group">
                <legend>Mot de passe</legend>
                {{ form_row(registrationForm.plainPassword) }}
            </fieldset>

            <div class="registration-terms">{{ form_row(registrationForm.agreeTerms) }}</div>
            <button class="vg-btn" type="submit">Créer mon compte</button>
            {{ form_end(registrationForm) }}

            <p>Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
        </section>
    </main>
{% endblock %}
