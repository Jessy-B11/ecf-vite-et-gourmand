{% extends 'base.html.twig' %}

{% block title %}
    Commande n°{{ commande.id }} — Gestion — Vite & Gourmand
{% endblock %}

{% block body %}
    {% set statuts = {
        en_attente: 'En attente',
        acceptee: 'Acceptée',
        en_preparation: 'En préparation',
        en_livraison: 'En livraison',
        livree: 'Livrée',
        attente_retour_materiel: 'En attente de retour du matériel',
        terminee: 'Terminée',
        annulee: 'Annulée'
    } %}

    <main class="container">
        <h1>Commande n°{{ commande.id }}</h1>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}" role="status">
                    {{ message }}
                </p>
            {% endfor %}
        {% endfor %}

        <p>
            Statut :
            <strong>
                {{ statuts[commande.statut] ?? commande.statut }}
            </strong>
        </p>

        <p>
            Créée le
            {{ commande.dateCreation|date('d/m/Y à H:i', 'Europe/Paris') }}
        </p>

        <section aria-labelledby="client-commande">
            <h2 id="client-commande">Client</h2>

            <p>
                {{ commande.utilisateur.prenom }}
                {{ commande.utilisateur.nom }}
            </p>

            <p>Email : {{ commande.utilisateur.email }}</p>
        </section>

        <section aria-labelledby="prestation-commande">
            <h2 id="prestation-commande">Prestation et livraison</h2>

            <p>Menu : {{ commande.menu.nom }}</p>

            <p>
                Nombre de personnes :
                {{ commande.nombrePersonnes }}
            </p>

            <p>
                Prestation :
                {{ commande.datePrestation|date('d/m/Y') }}
                à {{ commande.heureLivraison|date('H:i') }}
            </p>

            <p>
                Adresse :
                {{ commande.adresseLivraison }},
                {{ commande.codePostalLivraison }}
                {{ commande.villeLivraison }}
            </p>

            <p>
                Téléphone de contact :
                {{ commande.telephoneContact }}
            </p>

            <p>
                Matériel prêté :
                {{ commande.materielPrete ? 'Oui' : 'Non' }}
            </p>
        </section>

        <section aria-labelledby="montants-commande">
            <h2 id="montants-commande">Montants enregistrés</h2>

            <p>
                Menu avant remise :
                {{ (commande.montantMenuCentimes / 100)
                    |number_format(2, ',', ' ') }} €
            </p>

            <p>
                Remise :
                {{ (commande.montantRemiseCentimes / 100)
                    |number_format(2, ',', ' ') }} €
            </p>

            <p>
                Livraison :
                {{ (commande.fraisLivraisonCentimes / 100)
                    |number_format(2, ',', ' ') }} €
            </p>

            <p>
                <strong>
                    Total :
                    {{ (commande.montantTotalCentimes / 100)
                        |number_format(2, ',', ' ') }} €
                </strong>
            </p>
        </section>

        {% if commande.statut == 'en_attente' %}
            <section aria-labelledby="actions-commande">
                <h2 id="actions-commande">Actions</h2>

                <form
                    method="post"
                    action="{{ path(
                        'app_gestion_commandes_accepter',
                        {id: commande.id}
                    ) }}"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                            'accepter_commande_' ~ commande.id
                        ) }}"
                    >

                    <button type="submit">
                        Accepter la commande
                    </button>
                </form>
            </section>
        {% endif %}

        {% set actionsSuivi = {
    acceptee: {
        statut: 'en_preparation',
        libelle: 'Commencer la préparation'
    },
    en_preparation: {
        statut: 'en_livraison',
        libelle: 'Démarrer la livraison'
    },
    en_livraison: {
        statut: 'livree',
        libelle: 'Confirmer la livraison'
    }
} %}

        {% if actionsSuivi[commande.statut] is defined %}
            {% set actionSuivi = actionsSuivi[commande.statut] %}

            <section aria-labelledby="suivi-commande">
                <h2 id="suivi-commande">Faire avancer la commande</h2>

                <form
                    method="post"
                    action="{{ path(
                'app_gestion_commandes_suivi',
                {
                    id: commande.id,
                    statut: actionSuivi.statut
                }
            ) }}"
                >
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token(
                    'suivi_commande_'
                    ~ commande.id
                    ~ '_'
                    ~ actionSuivi.statut
                ) }}"
                    >

                    <button type="submit">
                        {{ actionSuivi.libelle }}
                    </button>
                </form>
            </section>
        {% endif %}

        <section aria-labelledby="historique-commande">
            <h2 id="historique-commande">Historique</h2>

            <ol>
                {% for evenement in historique %}
                    <li>
                        <p>
                            {{ evenement.dateChangement
                                |date('d/m/Y à H:i:s', 'Europe/Paris') }}
                            —
                            {{ statuts[evenement.statut]
                                ?? evenement.statut }}
                        </p>

                        <p>
                            Auteur :
                            {% if evenement.auteur is not null %}
                                {{ evenement.auteur.prenom }}
                                {{ evenement.auteur.nom }}
                                (compte n°{{ evenement.auteur.id }})
                            {% else %}
                                Non renseigné
                            {% endif %}
                        </p>

                        {% if evenement.modeContact is not null %}
                            <p>
                                Mode de contact :
                                {{ evenement.modeContact }}
                            </p>
                        {% endif %}

                        {% if evenement.motif is not null %}
                            <p>Motif : {{ evenement.motif }}</p>
                        {% endif %}
                    </li>
                {% else %}
                    <li>Aucun événement enregistré.</li>
                {% endfor %}
            </ol>
        </section>

        <p>
            <a href="{{ path('app_gestion_commandes') }}">
                Revenir à la liste des commandes
            </a>
        </p>
    </main>
{% endblock %}
