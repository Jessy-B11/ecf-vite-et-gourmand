{% extends 'base.html.twig' %}

{% block title %}
    Vérifier la modification — Commande n°{{ commande.id }}
{% endblock %}

{% block body %}
    <main class="container">
        <h1>Vérifier la modification de la commande n°{{ commande.id }}</h1>

        <p>Menu conservé : {{ commande.menu.nom }}</p>

        {% if erreur is not null %}
            <p class="form-error" role="alert">
                {{ erreur }}
            </p>
        {% endif %}

        {% if adresseForm is not null %}
            <section aria-labelledby="choix-adresse">
                <h2 id="choix-adresse">Vérifier la nouvelle adresse</h2>

                {{ form_start(adresseForm) }}
                    {{ form_errors(adresseForm) }}
                    {{ form_row(adresseForm.adresse) }}

                    <button type="submit">
                        Vérifier l’adresse et calculer le total
                    </button>
                {{ form_end(adresseForm) }}
            </section>
        {% endif %}

        {% if recapitulatif is not null %}
            <section aria-labelledby="recapitulatif">
                <h2 id="recapitulatif">Récapitulatif proposé</h2>

                <p>
                    Nombre de personnes :
                    {{ recapitulatif.nombre_personnes }}
                </p>

                <p>
                    Prestation :
                    {{ recapitulatif.date_prestation|date('d/m/Y') }}
                    à {{ recapitulatif.heure_livraison }}
                </p>

                <p>Adresse : {{ recapitulatif.adresse }}</p>

                <p>
                    Téléphone :
                    {{ brouillon.donnees.telephone_contact }}
                </p>

                <p>
                    Menu avant remise :
                    {{ (recapitulatif.montant_menu / 100)
                        |number_format(2, ',', ' ') }} €
                </p>

                <p>
                    Remise :
                    {{ (recapitulatif.remise / 100)
                        |number_format(2, ',', ' ') }} €
                </p>

                {% if recapitulatif.distance_metres is not null %}
                    <p>
                        Distance routière aller :
                        {{ (recapitulatif.distance_metres / 1000)
                            |number_format(3, ',', ' ') }} km
                    </p>
                {% endif %}

                <p>
                    {% if recapitulatif.adresse_identique %}
                        Frais de livraison conservés :
                    {% else %}
                        Frais de livraison recalculés :
                    {% endif %}

                    {{ (recapitulatif.frais_livraison / 100)
                        |number_format(2, ',', ' ') }} €
                </p>

                <p>
                    <strong>
                        Nouveau total :
                        {{ (recapitulatif.total / 100)
                            |number_format(2, ',', ' ') }} €
                    </strong>
                </p>

                <p>
                    Contact :
                    {{ brouillon.mode_contact == 'telephone'
                        ? 'Téléphone'
                        : 'Email' }}
                </p>

                <p>Motif : {{ brouillon.motif }}</p>

                <p>Aucune modification n’est encore enregistrée.</p>
                {% if jeton_confirmation is not null %}
                    <form
                        method="post"
                        action="{{ path('app_gestion_modification_commande_confirmer', {
            jeton: jeton_confirmation
        }) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token(
                'confirmer_modification_equipe_' ~ jeton_confirmation
            ) }}"
                        >

                        <button type="submit">
                            Confirmer et enregistrer
                        </button>
                    </form>
                {% endif %}
            </section>
        {% endif %}

        <p>
            <a
                href="{{ path('app_gestion_commandes_modifier', {
                id: commande.id
            }) }}"
            >
                Recommencer la modification
            </a>
        </p>

        <p>
            <a
                href="{{ path('app_gestion_commandes_show', {
                id: commande.id
            }) }}"
            >
                Revenir au détail
            </a>
        </p>
    </main>
{% endblock %}
