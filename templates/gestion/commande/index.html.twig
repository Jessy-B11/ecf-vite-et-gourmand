{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes — Vite & Gourmand{% endblock %}

{% block body %}
    <main class="container">
        <h1>Gestion des commandes</h1>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <p class="flash flash-{{ type }}" role="status">
                    {{ message }}
                </p>
            {% endfor %}
        {% endfor %}

        <form
            method="get"
            action="{{ path('app_gestion_commandes') }}"
        >
            <div>
                <label for="filtre-statut">Statut</label>

                <select id="filtre-statut" name="statut">
                    <option value="">Tous les statuts</option>

                    {% for valeur, libelle in statuts %}
                        <option
                            value="{{ valeur }}"
                            {% if filtre_statut == valeur %}selected{% endif %}
                        >
                            {{ libelle }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label for="filtre-client">
                    Client : nom, prénom ou email
                </label>

                <input
                    type="search"
                    id="filtre-client"
                    name="client"
                    value="{{ filtre_client }}"
                    maxlength="100"
                >
            </div>

            <button type="submit">Filtrer</button>

            <a href="{{ path('app_gestion_commandes') }}">
                Réinitialiser les filtres
            </a>
        </form>

        <p>
            Jusqu’à 50 commandes correspondant aux filtres,
            des plus récentes aux plus anciennes.
        </p>

        {% for commande in commandes %}
            <article>
                <h2>
                    <a
                        href="{{ path(
                            'app_gestion_commandes_show',
                            {id: commande.id}
                    ) }}"
                    >
                        Commande n°{{ commande.id }}
                    </a>
                </h2>

                <p>
                    Client :
                    {{ commande.utilisateur.prenom }}
                    {{ commande.utilisateur.nom }}
                </p>

                <p>Menu : {{ commande.menu.nom }}</p>

                <p>
                    Nombre de personnes :
                    {{ commande.nombrePersonnes }}
                </p>

                <p>
                    Prestation :
                    {{ commande.datePrestation|date('d/m/Y') }}
                    à {{ commande.heureLivraison|date('H:i') }}
                </p>

                <p>
                    Statut :
                    {{ statuts[commande.statut]
                        ?? commande.statut }}
                </p>

                <p>
                    Total :
                    {{ (commande.montantTotalCentimes / 100)
                        |number_format(2, ',', ' ') }} €
                </p>
                {% if commande.statut == 'en_attente' %}
                    <form
                        method="post"
                        action="{{ path(
            'app_gestion_commandes_accepter',
            {id: commande.id}
        ) }}"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token(
                'accepter_commande_' ~ commande.id
            ) }}"
                        >

                        <button type="submit">
                            Accepter la commande n°{{ commande.id }}
                        </button>
                    </form>
                {% endif %}
            </article>
        {% else %}
            <p>Aucune commande ne correspond aux filtres.</p>
        {% endfor %}
    </main>
{% endblock %}
