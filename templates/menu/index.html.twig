{% extends 'base.html.twig' %}

{% block title %}Nos menus — Vite & Gourmand{% endblock %}

{% block body %}
    <main class="container catalogue">
        <h1>Nos menus</h1>
        <p class="catalogue-introduction">Trouvez le menu adapté à votre événement et à vos convives.</p>

        <div class="catalogue-layout">
            <aside class="catalogue-filters" aria-labelledby="filtres-titre">
                <h2 id="filtres-titre">Filtres</h2>
                <form id="menu-filters" method="get" action="{{ path('app_menu') }}" aria-describedby="menu-prix-info">
                    <div class="catalogue-field">
                        <label for="prix-min">Prix minimum (€)</label>

                        <input
                            type="number"
                            id="prix-min"
                            name="prix_min"
                            min="0"
                            step="0.01"
                            placeholder="Exemple : 100"
                            value="{{ prix_min }}"
                        >
                    </div>

                    <div class="catalogue-field">
                        <label for="prix-max">Prix maximum (€)</label>

                        <input
                            type="number"
                            id="prix-max"
                            name="prix_max"
                            min="0"
                            step="0.01"
                            placeholder="Exemple : 150"
                            value="{{ prix_max }}"
                        >
                    </div>

                    <div class="catalogue-field">
                        <label for="theme">Thème</label>

                        <select id="theme" name="theme">
                            <option value="">Tous les thèmes</option>

                            {% for theme in themes %}
                                <option
                                    value="{{ theme.id }}"
                                    {% if theme_selectionne == theme.id %}selected{% endif %}
                                >
                                    {{ theme.libelle }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="catalogue-field">
                        <label for="regime">Régime alimentaire</label>

                        <select id="regime" name="regime">
                            <option value="">Tous les régimes</option>

                            {% for regime in regimes %}
                                <option
                                    value="{{ regime.id }}"
                                    {% if regime_selectionne == regime.id %}selected{% endif %}
                                >
                                    {{ regime.libelle }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="catalogue-field">
                        <label for="nombre-personnes">Nombre de convives prévu</label>

                        <input
                            type="number"
                            id="nombre-personnes"
                            name="nombre_personnes"
                            min="1"
                            max="999999"
                            step="1"
                            placeholder="Exemple : 6"
                            value="{{ nombre_personnes }}"
                        >
                    </div>

                    <div class="catalogue-filter-actions">
                        <button class="vg-btn" type="submit">Filtrer</button>
                        <a class="vg-btn vg-btn--secondaire" id="reset-filters" href="{{ path('app_menu') }}">
                            Réinitialiser
                        </a>
                    </div>

                    <p class="catalogue-note" id="menu-prix-info">Les prix affichés correspondent au minimum de convives.</p>
                </form>
            </aside>

            <section class="catalogue-results" aria-label="Résultats du catalogue">
                <p id="filter-status" role="status" aria-live="polite"></p>
                <div id="menu-results">
                    {% if erreur_filtres %}
                        <p class="form-error" role="alert">
                            {{ erreur_filtres }}
                        </p>
                    {% endif %}

                    <div class="menus-grid">
                        {% for menu in menus %}
                            <article class="menu-card">
                                <h2>{{ menu.nom }}</h2>
                                <p>{{ menu.description }}</p>

                                <p>
                                    Minimum : {{ menu.minimumPersonnes }} personnes
                                </p>

                                <p>
                                    Prix pour ce minimum :
                                    {{ (menu.prixMinimumCentimes / 100)|number_format(2, ',', ' ') }} €
                                </p>

                                <p>
                                    Prix par personne :
                                    {{ (menu.prixMinimumCentimes / menu.minimumPersonnes / 100)|number_format(2, ',', ' ') }} €
                                </p>

                                <p>
                                    Thème : {{ menu.theme.libelle }}
                                    — Régime : {{ menu.regime.libelle }}
                                </p>

                                {% if menu.stockCommandes > 0 %}
                                    <p>{{ menu.stockCommandes }} commandes disponibles</p>
                                {% else %}
                                    <p>Indisponible</p>
                                {% endif %}

                                <p>
                                    <a class="vg-btn" href="{{ path('app_menu_show', {id: menu.id}) }}">
                                        Voir le détail
                                    </a>
                                </p>
                            </article>
                        {% else %}
                            {% if not erreur_filtres %}
                                <p>Aucun menu disponible pour le moment.</p>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </section>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="/js/menu-filters.js" defer></script>
{% endblock %}
