{% extends 'base.html.twig' %}

{% block title %}{{ menu.nom }} — Vite & Gourmand{% endblock %}

{% block body %}
    <main class="container">
        <a href="{{ path('app_menu') }}">Retour aux menus</a>

        <h1>{{ menu.nom }}</h1>
        <p>{{ menu.description }}</p>
        {% if menu.images is not empty %}
            <section aria-labelledby="galerie-title">
                <h2 id="galerie-title">En images</h2>

                <div class="menu-gallery">
                    {% for image in menu.images %}
                        <img
                            src="{{ image.chemin }}"
                            alt="{{ image.textAlternatif }}"
                            loading="lazy"
                            <p
                        >Illustration générée par IA pour ce menu de démonstration.</p>
                        >
                    {% endfor %}
                </div>
            </section>
        {% endif %}
        <p>
            Minimum : {{ menu.minimumPersonnes }} personnes
            — Prix :
            {{ (menu.prixMinimumCentimes / 100)|number_format(2, ',', ' ') }} €
            pour ce minimum
        </p>

        <p>
            Prix par personne :
            {{ (menu.prixMinimumCentimes / menu.minimumPersonnes / 100)|number_format(2, ',', ' ') }} €
        </p>

        <p>
            Thème : {{ menu.theme.libelle }}
            — Régime : {{ menu.regime.libelle }}
        </p>

        {% if menu.stockCommandes > 0 %}
            <p>{{ menu.stockCommandes }} commandes disponibles</p>
        {% else %}
            <p>Ce menu est actuellement indisponible à la commande.</p>
        {% endif %}

        <section aria-labelledby="conditions-title">
            <h2 id="conditions-title">Conditions de commande</h2>
            <p>{{ menu.conditions }}</p>
        </section>

        <section aria-labelledby="plats-title">
            <h2 id="plats-title">Composition du menu</h2>

            {% for plat in menu.plats %}
                <article class="menu-card">
                    <h3>{{ plat.nom }}</h3>
                    <p>{{ plat.description }}</p>

                    <p>
                        Allergènes :
                        {% for allergene in plat.allergenes %}
                            {{ allergene.libelle }}{% if not loop.last %}, {% endif %}
                        {% else %}
                            aucun allergène renseigné
                        {% endfor %}
                    </p>
                </article>
            {% else %}
                <p>La composition sera prochainement renseignée.</p>
            {% endfor %}
        </section>
    </main>
{% endblock %}
