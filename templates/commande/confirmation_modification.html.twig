{% extends 'base.html.twig' %}

{% block title %}Confirmer les modifications — Vite & Gourmand{% endblock %}

{% block body %}
    {% set donnees = confirmation.donnees %}

    <main class="container">
        <h1>Confirmer les modifications</h1>

        <p>
            Commande n°{{ commande.id }}
            — {{ commande.menu.nom }}
        </p>

        <h2>Informations à enregistrer</h2>

        <p>
            Nombre de personnes : {{ donnees.nombre_personnes }}
        </p>

        <p>
            Prestation :
            {{ donnees.date_prestation|date('d/m/Y') }}
            à {{ donnees.heure_livraison }}
        </p>

        <p>
            Livraison :
            {{ donnees.adresse_livraison }},
            {{ donnees.code_postal_livraison }}
            {{ donnees.ville_livraison }}
        </p>

        <p>
            Téléphone : {{ donnees.telephone_contact }}
        </p>

        <p>
            Menu avant remise :
            {{ (recapitulatif.montant_menu / 100)
                |number_format(2, ',', ' ') }} €
        </p>

        <p>
            Remise :
            {{ (recapitulatif.remise / 100)
                |number_format(2, ',', ' ') }} €
        </p>

        <p>
            Frais de livraison :
            {{ (recapitulatif.frais_livraison / 100)
                |number_format(2, ',', ' ') }} €
        </p>

        <p>
            Total actuellement enregistré :
            {{ (commande.montantTotalCentimes / 100)
                |number_format(2, ',', ' ') }} €
        </p>

        <p>
            <strong>
                Nouveau total :
                {{ (recapitulatif.total / 100)
                    |number_format(2, ',', ' ') }} €
            </strong>
        </p>

        <form
            method="post"
            action="{{ path(
                'app_modification_commande_confirmation',
                {jeton: confirmation.jeton}
            ) }}"
        >
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token(
                    'modifier_commande_' ~ confirmation.jeton
                ) }}"
            >

            <button type="submit">
                Confirmer les modifications
            </button>
        </form>

        <p>
            <a
                href="{{ path('app_mes_commandes_show', {
                id: commande.id
            }) }}"
            >
                Revenir à ma commande sans enregistrer
            </a>
        </p>
    </main>
{% endblock %}
