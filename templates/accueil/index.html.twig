{% extends 'base.html.twig' %}

{% block title %}Accueil — Vite & Gourmand{% endblock %}

{% block body %}
    <main class="container accueil">
        <section class="accueil-hero" aria-labelledby="accueil-titre">
            <div>
                <p class="accueil-surtitre">Traiteur à Bordeaux</p>
                <h1 id="accueil-titre">Des repas pour chaque moment</h1>
                <p class="accueil-introduction">
                    Julie et José préparent des menus pour vos repas de famille,
                    fêtes et événements à Bordeaux.
                </p>
                <a class="vg-btn accueil-bouton" href="{{ path('app_menu') }}">
                    Voir nos menus
                </a>
            </div>

            <img
                class="accueil-photo"
                src="/images/menus/poulet-roti.png"
                alt="Poulet rôti accompagné de riz blanc et de persil"
            >
        </section>

        <section class="accueil-presentation" aria-labelledby="accueil-equipe">
            <h2 id="accueil-equipe">Julie, José et leur savoir-faire</h2>
            <p>Une cuisine chaleureuse et soignée pour recevoir à votre façon.</p>

            <ul class="accueil-atouts">
                <li class="accueil-atout">
                    <h3>25 ans d’expérience</h3>
                    <p>Une équipe qui vous accompagne dans vos choix.</p>
                </li>
                <li class="accueil-atout">
                    <h3>Qualité des produits</h3>
                    <p>Des menus conçus autour des saisons.</p>
                </li>
                <li class="accueil-atout">
                    <h3>Livraison à domicile</h3>
                    <p>À Bordeaux et dans les communes alentour.</p>
                </li>
            </ul>
        </section>

        <section class="accueil-section accueil-menus" aria-labelledby="accueil-menus-titre">
            <h2 id="accueil-menus-titre">Nos menus du moment</h2>

            {% if menusDuMoment is empty %}
                <p>Aucun menu disponible pour le moment.</p>
            {% else %}
                <div class="menus-grid">
                    {% for menu in menusDuMoment %}
                        {% include 'menu/_card.html.twig' with {menu: menu, heading_tag: 'h3'} only %}
                    {% endfor %}
                </div>
            {% endif %}

            <p class="accueil-catalogue-action">
                <a class="vg-btn vg-btn--secondaire" href="{{ path('app_menu') }}">Découvrir tous les menus</a>
            </p>
        </section>

        <section class="accueil-section" aria-labelledby="avis-clients">
            <h2 id="avis-clients">Avis clients validés</h2>

            {% if avisValides is empty %}
                <p>Aucun avis publié pour le moment.</p>
            {% else %}
                <div class="accueil-avis">
                    {% for avis in avisValides %}
                        <article class="accueil-avis-carte">
                            <h3>Note de {{ avis.note }} sur 5</h3>
                            <p>{{ avis.commentaire }}</p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
{% endblock %}
